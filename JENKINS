pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build Docker Image') {
            steps {
                script {
                    app = docker.build("your-registry/traffic-dashboard:${env.BUILD_ID}")
                }
            }
        }
        stage('Automated Health & Static Check') {
            steps {
                sh 'echo "Running HTML / syntax validation..."'
                sh 'test -f index.html && test -f Dockerfile'
            }
        }
        stage('Controlled Deployment') {
            steps {
                sh 'kubectl apply -f deployment.yaml'
                sh "kubectl set image deployment/traffic-dashboard-deployment traffic-dashboard=your-registry/traffic-dashboard:${env.BUILD_ID}"
            }
        }
    }
    post {
        failure {
            script {
                echo "Release failed! Rolling back to previous stable deployment..."
                sh 'kubectl rollout undo deployment/traffic-dashboard-deployment'
            }
        }
    }
}
